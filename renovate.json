{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "rust-toolchain": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchSourceUrls": ["https://github.com/esp-rs/esp-hal"],
      "groupName": "esp-rs crates"
    },
    {
      "matchSourceUrls": ["https://github.com/embassy-rs/embassy"],
      "groupName": "embassy crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embedded-hal",
        "embedded-hal-bus",
        "embedded-graphics",
        "mipidsi"
      ],
      "groupName": "display and hal crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embedded-storage",
        "embedded-storage-async",
        "sequential-storage"
      ],
      "groupName": "storage crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde-json-core"],
      "groupName": "serde"
    }
  ]
}
