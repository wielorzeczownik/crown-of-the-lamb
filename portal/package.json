{
  "name": "crown-of-the-lamb-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src plugins index.html tests",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write src plugins index.html tests",
    "format:check": "prettier --check src plugins index.html tests",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix src plugins index.html tests && stylelint --fix \"src/**/*.css\" && prettier --write src plugins index.html tests"
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "0.64.0",
    "@html-eslint/parser": "0.64.0",
    "@types/ejs": "3.1.5",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "26.1.2",
    "@types/subset-font": "2.3.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "73.0.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "subset-font": "2.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
