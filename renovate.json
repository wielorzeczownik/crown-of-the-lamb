{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "rust-toolchain": {
    "description": "The esp channel is managed by espup, not Renovate.",
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+tool: \\S+@(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+run: cargo install \\S+ --locked --version (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["buildDependencies", "devDependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "esp-hal",
        "esp-rtos",
        "esp-radio",
        "esp-alloc",
        "esp-storage",
        "esp-println",
        "esp-bootloader-esp-idf"
      ],
      "groupName": "esp-rs crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embassy-executor",
        "embassy-sync",
        "embassy-time",
        "embassy-net"
      ],
      "groupName": "embassy crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embedded-hal",
        "embedded-hal-bus",
        "embedded-graphics",
        "mipidsi"
      ],
      "groupName": "display and hal crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "embedded-storage",
        "embedded-storage-async",
        "sequential-storage"
      ],
      "groupName": "storage crates"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["serde", "serde-json-core"],
      "groupName": "serde"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
